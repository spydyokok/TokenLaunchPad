{
  "name": "tokenlaunchpad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "compile": "node scripts/compile.mjs",
    "deploy:local": "node scripts/deploy.mjs",
    "chain": "ganache --chain.chainId 31337 --wallet.deterministic"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.15.0"
  },
  "devDependencies": {
    "@foundry-rs/forge": "1.7.1",
    "ganache": "7.9.2",
    "jsdom": "26.0.0",
    "solc": "0.8.30",
    "vite": "6.1.0"
  }
}
